# Application Settings
ENV=development
APP_NAME="Auth Application"
SECRET_KEY="your-super-secret-jwt-key-change-this-in-production"
API_DOMAIN=http://localhost:8000
WEBSITE_DOMAIN=http://localhost:8000

# Database (Defaults to SQLite; in production set to PostgreSQL, e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./users.db

# Social Logins (Google, GitHub, Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Fast2SMS — Phone OTP SMS delivery (India)
FAST2SMS_API_KEY=

# Brevo — Transactional email (password reset)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
